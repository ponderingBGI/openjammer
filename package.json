{
  "name": "openjammer",
  "version": "0.0.0",
  "description": "Browser-based node-driven music creation tool for live performance",
  "license": "AGPL-3.0-only",
  "author": "OpenJammer Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/PonderingBGI/openjammer.git"
  },
  "keywords": [
    "music",
    "audio",
    "web-audio",
    "live-performance",
    "node-based",
    "looper",
    "pwa"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_execpath?.includes('bun')){console.error('\\x1b[31mError: Use bun to install dependencies.\\nRun: bun install\\x1b[0m');process.exit(1)}\"",
    "postinstall": "bun scripts/install-git-hooks.ts",
    "setup:hooks": "bun scripts/install-git-hooks.ts",
    "dev": "vite",
    "native": "bun scripts/oj/index.ts dev",
    "native:all": "bun scripts/oj/index.ts dev --all",
    "native:plugins": "bun scripts/oj/index.ts dev --plugins",
    "native:clap": "bun scripts/oj/index.ts dev --clap",
    "dev:native": "bun scripts/oj/index.ts dev",
    "oj": "bun scripts/oj/index.ts",
    "build": "tsc -b && vite build",
    "build:pi-runtime": "bun scripts/build-pi-runtime.ts",
    "tokens": "bun ./packages/oj-tokens/build.mjs",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "gen:component-map": "ladle build >/dev/null 2>&1 && bun scripts/oj/index.ts design map",
    "design:status": "bun scripts/oj/index.ts design status",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cli": "bun test scripts/oj/__tests__",
    "test:pi-ext": "node --test pi-extensions/permission-gate/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config=playwright.perf.config.ts",
    "bench:web": "vitest bench --run --config vitest.bench.config.ts",
    "bench": "cargo bench -p ojcore -p ojcore-dsp -p ojproto -p ojinstrument -p ojhost",
    "bench:codspeed:build": "cargo codspeed build -m simulation -m memory -p ojcore -p ojcore-dsp -p ojproto -p ojinstrument -p ojhost",
    "bench:codspeed:run": "cargo codspeed run -m simulation && cargo codspeed run -m memory",
    "tauri": "tauri"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.10.38",
    "caniuse-lite": "^1.0.30001799",
    "cmdk": "1.1.1",
    "idb-keyval": "^6.2.2",
    "loro-crdt": "1.14.1",
    "lru-cache": "^11.2.4",
    "music-metadata": "^11.10.3",
    "react": "^19.2.0",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "sonner": "^2.0.7",
    "use-debounce": "^10.0.6",
    "vite-plugin-pwa": "^1.2.0",
    "web-audio-beat-detector": "^8.2.32",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@earendil-works/pi-coding-agent": "0.79.6",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^1.4.8",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.11.0",
    "jsdom": "^27.3.0",
    "style-dictionary": "^5.4.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.0.15"
  }
}
