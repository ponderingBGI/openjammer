{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenJammer",
  "version": "0.1.0-alpha.2",
  "identifier": "in.lionman.openjammer",
  "build": {
    "beforeDevCommand": "bun run build:pi-runtime && bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:pi-runtime && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenJammer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Node-driven music creation for live performance.",
    "longDescription": "OpenJammer is a node-based music creation tool for live performance. This native desktop build runs the low-latency Rust ojcore engine behind the existing web UI.",
    "resources": {
      "binaries/": "pi-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRjM2MDZCNkYxRDY1RTYKUldUbVpSMXZhMkR6TXU0V3dZUzdzUnQ5bG1IZ2RBMkRyZnZWVDk2elA5YWgwdXlkUHFyZ3V3WDMK",
      "endpoints": [
        "https://github.com/ponderingBGI/openjammer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
