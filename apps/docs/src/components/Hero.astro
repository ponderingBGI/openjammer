---
// The ONE bespoke component override (hard cap). Starlight calls this on every
// page render, but only the splash template populates `data.hero` — so we read
// the route entry the way Starlight's own Hero does (`Astro.locals.starlightRoute`
// in 0.34, NOT `Astro.props.entry`, which is undefined here) and render nothing
// unless a `hero` block is present. Verified against @astrojs/starlight ^0.34.
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---
{data.hero && (
<div class="oj-hero">
  <div class="oj-hero-grid">
    <h1 set:html={title} />
    {tagline && <p class="oj-tagline" set:html={tagline} />}
    <p class="oj-tiers">
      <span class="oj-tier oj-tier--native">native <code>device-dependent</code></span>
      <span class="oj-tier oj-tier--browser">browser <code>~15-25ms</code></span>
    </p>
    {actions.length > 0 && (
      <div class="oj-actions">
        {actions.map((a) => (
          <a class={`sl-link-button ${a.variant ?? 'primary'}`} href={a.link}>{a.text}</a>
        ))}
      </div>
    )}
  </div>
</div>
)}
<!--
  New DNA, tokens only: the hero is a surface CARD (one hairline, soft layered
  depth) on the same dot-grid ground as the canvas, and the two tier pills are
  Chips — an inset pill whose tone recolours the TEXT, never a coloured ring.
  Both themes come from the tokens themselves, so there is no dark block here.
-->
<style>
  .oj-hero{ padding:var(--space-xl) 0 var(--space-md); }
  .oj-hero-grid{ border:1px solid var(--border-subtle); border-radius:var(--radius-xl);
    box-shadow:var(--shadow-overlay); padding:var(--space-xl) var(--space-lg); background:var(--bg-node);
    background-image:radial-gradient(circle, var(--border-subtle) 1px, transparent 1px); background-size:20px 20px; }
  .oj-hero h1{ font-family:var(--font-sans); font-weight:700; font-size:var(--text-2xl); line-height:1.15; letter-spacing:-0.01em; margin:0 0 var(--space-sm); }
  .oj-tagline{ font-family:var(--font-sans); font-size:var(--text-lg); font-weight:500; color:var(--text-secondary); max-width:46ch; }
  .oj-tiers{ display:flex; gap:var(--space-sm); flex-wrap:wrap; margin:var(--space-md) 0 var(--space-lg); }
  .oj-tier{ font-family:var(--font-sans); font-size:var(--text-sm); font-weight:600;
    border-radius:var(--radius-pill); padding:var(--space-xs) var(--space-sm);
    background:var(--bg-tertiary); color:var(--text-secondary); }
  .oj-tier code{ font-family:var(--font-mono); color:var(--text-primary); }
  .oj-actions{ display:flex; gap:var(--space-sm); flex-wrap:wrap; }
</style>
