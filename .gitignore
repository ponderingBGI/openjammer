# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lock files (bun only - no npm/yarn/pnpm)
package-lock.json
yarn.lock
pnpm-lock.yaml
shrinkwrap.json

node_modules
dist
dist-ssr
*.local

# Playwright (E2E) artifacts — generated on every run.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Cargo (ojcore workspace)
/target

# Claude Code agent worktrees (transient)
.claude/worktrees/

# === Signing keys & secrets (R4 — committed BEFORE any `tauri signer generate`) ===
# minisign / Tauri updater private keys (split stable + canary keypairs).
# A leaked signing key is the single worst outcome for the updater root-of-trust.
*.key
openjammer.key
*.minisign

# OS code-signing material (Authenticode / Apple Developer ID workflows).
*.pem
*.p12
*.pfx

# Tauri's signer scratch / updater key cache.
.tauri/

# Local scratch files (commit messages, PR bodies, validation scripts).
*.tmp
.git-commit-msg.tmp
.pr-body.tmp

# oj preflight content-addressed cache (Layer 2 fast-feedback).
.oj-cache/
