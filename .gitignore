# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lock files (bun only - no npm/yarn/pnpm)
package-lock.json
yarn.lock
pnpm-lock.yaml
shrinkwrap.json

node_modules
dist
dist-ssr
*.local

# oj-tokens ships its generated outputs (drift-guarded by `bun run tokens`);
# keep them tracked even though the bare `dist` rule above would ignore them.
!/packages/oj-tokens/dist
!/packages/oj-tokens/dist/**

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Cargo (ojcore workspace)
/target

# Generated native sidecars/resources (rebuilt by bun run build:pi-runtime)
/src-tauri/binaries

# cargo-fuzz build + run artifacts (Lane B)
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage
/fuzz/Cargo.lock

# Claude Code agent worktrees (transient)
.claude/worktrees/

# impeccable design-detector hook caches (regenerated; never ship/commit)
.impeccable/

# Playwright e2e artifacts (regenerated on every run)
test-results/
playwright-report/

# Ladle component-catalog build output
.ladle/build/

# Update-signing key material — NEVER commit (RCE-grade). Private keys live only
# on the maintainer's offline backups + in GitHub Actions secrets. Public `.pub`
# keys are embedded directly in tauri.conf.json / updater.rs instead.
.tauri/
*.key
*.minisign
*.pass
